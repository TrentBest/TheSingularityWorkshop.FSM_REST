<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>TheSingularityWorkshop.FSM_Rest.COS</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>Trent Best</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>FSM_COS integration adapters for REST capabilities.</Description>
    <PackageTags>REST;FSM_COS;MicroBundle;composition;TheSingularityWorkshop</PackageTags>
    <PackageProjectUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_REST</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.FSM_REST</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Alpha 1: introduces the optional FSM_COS MicroBundle adapter for reusable REST capability descriptors.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' != 'true'">
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FSM_REST/FSM_REST.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <ProjectReference Include="../../../TheSingularityWorkshop.MicroBundleDomain/TheSingularityWorkshop.MicroBundleDomain.csproj" />
  </ItemGroup>
  <Target Name="ValidateWorkshopRepositorySources" BeforeTargets="PrepareForBuild" Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <Error Condition="!Exists('../../../TheSingularityWorkshop.MicroBundleDomain/TheSingularityWorkshop.MicroBundleDomain.csproj')" Text="WorkshopUseRepositorySources=true requires TheSingularityWorkshop.MicroBundleDomain beside this repository." />
  </Target>
  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
